PORT=8080
DATABASE_PATH=/data/parkit.db
SECRET_KEY=change-me

# Set this on any VPS reachable from the internet. Empty = open admin (local/dev only).
OWNER_PASSWORD=

BUSINESS_NAME=
PUBLIC_BASE_URL=http://localhost:8080

# Optional parts-runner notify destinations.
RUNNER_EMAIL=
RUNNER_PHONE=

FROM_NAME=
FROM_EMAIL=

# Optional SMTP. Leave SMTP_HOST unset; Build + Copy/CSV still work.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true

# Optional Twilio SMS. Leave unset.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Optional title→tag LLM (≤3s timeout; falls back to keyword rules).
# OLLAMA_BASE_URL=
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Optional footer link labeled "Powered by ParKit". Leave empty for no footer.
MARKETING_URL=
